import struct

# CODATA 2018 Stefan-Boltzmann constant
sigma = 5.670374419e-8

# Get the f64 (double precision) bits
bits = struct.pack('d', sigma)
unpacked = struct.unpack('Q', bits)[0]

# Decode IEEE 754
sign = (unpacked >> 63) & 1
exponent = ((unpacked >> 52) & 0x7FF) - 1023
mantissa_bits = unpacked & ((1 << 52) - 1)
mantissa = 1 + mantissa_bits / (2**52)

value = ((-1)**sign) * mantissa * (2**exponent)

# ULP in this range
ulp = 2**(exponent - 52)

print(f'CODATA 2018 sigma: {sigma}')
print(f'Exact f64 representation: {value}')
print(f'Relative error: {(value - sigma)/sigma}')
print(f'ULP (unit in last place): {ulp}')
print(f'ULP relative: {ulp/sigma:.2e}')
print(f'Decimal digits of ULP: {abs(ulp/sigma):.2e}')

# Check: is the error smaller than the last significant digit?
# CODATA 2018 has 10 significant digits: 5.670374419e-8
# The precision of the last digit (9) is at 1e-18 (since value is ~5.67e-8,
# the 10th significant digit is at 1e-18)
print(f'Last digit place: {1e-18}')
print(f'F64 representation error << last digit? {(value - sigma) < 1e-18}')
print()

# Compare: what if we had only 9 significant digits?
sigma_9 = 5.67037441e-8
print(f'9 sigdig version: {sigma_9}')
print(f'Difference from CODATA: {sigma_9 - sigma}')

# Compare: what if we had 5.67e-8 (EnergyPlus lower precision)?
sigma_ep_low = 5.67e-8
print(f'EnergyPlus low (5.67e-8): diff = {sigma_ep_low - sigma}')

# Compare: what if we had 5.6697e-8 (EnergyPlus/OCHRE)?
sigma_ep = 5.6697e-8
print(f'EnergyPlus/OCHRE (5.6697e-8): diff = {sigma_ep - sigma}')

# Compare: what if we had 5.6704e-8 (OCHRE Envelope.py)?
sigma_ochre = 5.6704e-8
print(f'OCHRE Envelope.py (5.6704e-8): diff = {sigma_ochre - sigma}')
"

