from decimal import Decimal, getcontext
getcontext().prec = 50

# HARES constant
hares = Decimal('29307.1070172222')
# NIST BTU
btu = Decimal('1055.05585262')
# Exact result
exact = Decimal('100000') * btu / Decimal('3600')

print(f'HARES:      {hares}')
print(f'Exact:      {exact}')
print(f'Difference: {hares - exact}')
print()

# How many ULPs in f64?
import struct
exact_f = float(exact)
hares_f = float(hares)
print(f'f64(HARES): {repr(hares_f)}')
print(f'f64(Exact): {repr(exact_f)}')
print(f'f64 diff:   {hares_f - exact_f}')
print()

# What does the HARES constant imply as a BTU value?
implied_btu = hares * Decimal('3600') / Decimal('100000')
print(f'HARES-implied BTU: {implied_btu}')
print(f'NIST BTU:          {btu}')
print(f'BTU delta:         {implied_btu - btu}')

# Does pint 0.25 therm definition use this BTU value?
# pint defines therm as 105505600.0 J (100_000 * 1055.056 = 105505600)
print()
print(f'pint likely therm value: 100000 * 1055.056 = {100000.0 * 1055.056}')
print(f'NIST therm value:        100000 * 1055.05585262 = {100000.0 * 1055.05585262}')
print(f'Difference: {100000.0 * 1055.056 - 100000.0 * 1055.05585262}')
"

