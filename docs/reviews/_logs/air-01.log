# ISO 2533/ICAO Standard Atmosphere (geopotential altitude)
p0 = 101325.0
T0 = 288.15
L = 0.0065
g0 = 9.80665
M0 = 0.0289644
R = 8.31432
E = g0 * M0 / (R * L)

import math
r0 = 6356766.0

