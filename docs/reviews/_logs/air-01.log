import math

# HARES constants
p0 = 101325.0
L_over_T0 = 2.25577e-5  # L/T0
E = 5.2558761

# ISA true constants for comparison
T0 = 288.15  # K
L = 0.0065   # K/m
g0 = 9.80665  # m/s^2
M0 = 0.0289644  # kg/mol
R_star = 8.31432  # J/(mol*K)
E_exact = g0 * M0 / (R_star * L)

print('=== Constants ===')
print(f'HARES E: {E}')
print(f'Exact E (USSA 1976): {E_exact}')
print(f'EnergyPlus E: 5.2559')
print(f'Difference HARES vs exact: {E - E_exact:.10e}')
print()

altitudes = [0, 500, 1000, 1609, 3000]
ep_hardcoded = [2.25577e-5, 5.2559]  # EnergyPlus hardcoded values

print(f'{'Alt(m)':>6}  {'HARES (Pa)':>14}  {'EP (Pa)':>14}  {'Exact ISA H(geo)':>18}  {'HARES-EP diff':>15}  {'Expected test':>14}  {'Tolerance':>10}')
print('-' * 108)

for h in altitudes:
    # HARES
    hares_p = p0 * (1.0 - L_over_T0 * h) ** E
    
    # EnergyPlus
    ep_p = p0 * (1.0 - ep_hardcoded[0] * h) ** ep_hardcoded[1]
    
    # Exact ISA with geometric-to-geopotential conversion
    # R_earth = 6356766 m (NASA Earth Fact Sheet mean radius, or use USSA 1976 value)
    # USSA 1976 uses: r0 = 6356766 m
    r0 = 6356766.0  # effective Earth radius per USSA 1976
    H = r0 * h / (r0 + h)  # geopotential altitude
    
    # But actually, for the ISA formula, we use the same formula with H
    # p = p0 * (1 - L*H/T0)^E
    # where L = 0.0065, T0 = 288.15
    exact_geo_p = p0 * (1.0 - L * H / T0) ** E_exact
    
    # Alternatively, if we just use geometric altitude directly (some tables are for geometric)
    exact_geom_p = p0 * (1.0 - L * h / T0) ** E_exact
    
    test_expected = {
        0: (101325.0, 0.1),
        500: (95461.0, 50.0),
        1000: (89874.6, 50.0),
        1609: (83460.0, 100.0),
        3000: (70108.0, 100.0),
    }.get(h, (0, 0))
    
    diff_hares_ep = hares_p - ep_p
    
    print(f'{h:>6}  {hares_p:>14.4f}  {ep_p:>14.4f}  {exact_geo_p:>18.8f}  {diff_hares_ep:>15.8f}  {test_expected[0]:>14.1f}  {test_expected[1]:>10.1f}')

print()
print('=== HARES vs USSA 1976 exact (geopotential conversion) ===')
for h in altitudes:
    hares_p = p0 * (1.0 - L_over_T0 * h) ** E
    r0 = 6356766.0
    H = r0 * h / (r0 + h)
    exact_geo_p = p0 * (1.0 - L * H / T0) ** E_exact
    diff = hares_p - exact_geo_p
    rel_diff_pct = diff / exact_geo_p * 100
    print(f'{h}m: HARES={hares_p:.4f}, USSA 1976 (geopot)={exact_geo_p:.4f}, diff={diff:.4f} Pa ({rel_diff_pct:.6f}%)')

print()
print('=== HARES vs USSA 1976 (geometric altitude, no conversion) ===')
for h in altitudes:
    hares_p = p0 * (1.0 - L_over_T0 * h) ** E
    exact_geom_p = p0 * (1.0 - L * h / T0) ** E_exact
    diff = hares_p - exact_geom_p
    rel_diff_pct = diff / exact_geom_p * 100
    print(f'{h}m: HARES={hares_p:.4f}, USSA 1976 (geom)={exact_geom_p:.4f}, diff={diff:.4f} Pa ({rel_diff_pct:.6f}%)')

print()
print('=== Known published ISA values ===')
# Standard ISA table values (commonly published)
published = {
    0: 101325.0,
    500: 95461.3,   # ISA standard value
    1000: 89876.3,  # ISA standard value  (or 89874.6 depending on source)
    1609: None,     # 1 mile - not a standard ISA table entry
    3000: 70121.2,  # ISA standard value (or 70108)
}
for h in altitudes:
    if published[h]:
        hares_p = p0 * (1.0 - L_over_T0 * h) ** E
        diff = hares_p - published[h]
        rel_diff_pct = (diff / published[h] * 100) if published[h] else 0
        print(f'{h}m: HARES={hares_p:.4f}, Published={published[h]:.4f}, diff={diff:.4f} Pa ({rel_diff_pct:.6f}%)')
"

