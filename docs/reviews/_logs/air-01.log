# Check the existing test: does it pass?
p0 = 101325.0
L = 2.25577e-5
E = 5.2558761

for h, expected, tol in [(0, 101325.0, 0.1), (500, 95461.0, 50.0), (1000, 89874.6, 50.0), (1609, 83460.0, 100.0), (3000, 70108.0, 100.0)]:
    p = p0 * (1.0 - L * h) ** E
    diff = abs(p - expected)
    pass_fail = 'PASS' if diff < tol else 'FAIL'
    print(f'{h}m: computed={p:.4f}, expected={expected}, diff={diff:.4f}, tol={tol}, {pass_fail}')
"

