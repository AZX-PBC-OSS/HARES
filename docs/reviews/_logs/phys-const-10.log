from decimal import Decimal, getcontext
getcontext().prec = 50

# NIST exact values
btu_IT_to_J = Decimal('1055.05585262')  # exact per NIST SP 811
seconds_per_hour = Decimal('3600')

# Exact conversion: W to BTU/h = 3600 / 1055.05585262
btu_per_hr_per_w_exact = seconds_per_hour / btu_IT_to_J
print('Exact NIST conversion (50 digit precision):')
print(f'  {btu_per_hr_per_w_exact}')
