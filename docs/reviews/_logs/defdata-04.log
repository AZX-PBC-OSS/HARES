import csv
# Analyze draw pattern times
events = []
with open('/Users/rich/source/HARES/defaults/water_heating/WH Medium UEF Schedule.csv') as f:
    r = csv.reader(f)
    next(r)
    for row in r:
        v = float(row[1])
        if v == 0: continue
        if '1/1/2018' not in row[0]: continue
        hm = row[0].split()[1]  # HH:MM
        events.append((hm, v))

print('Draw events (Day 1):')
print(f'Total events: {len(events)}')
for t, v in events:
    print(f'  {t}: {v:.2f} L/min')
# Group by hour
hourly = {}
for t, v in events:
    h = int(t.split(':')[0])
    hourly[h] = hourly.get(h, 0) + v
print()
print('Hourly totals (L):')
for h in sorted(hourly):
    print(f'  {h:02d}:00 = {hourly[h]:.2f} L')
