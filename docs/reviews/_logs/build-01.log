import re

with open('Cargo.lock') as f:
    content = f.read()

lines = content.split('\n')
packages = {}
current_name = None
current_version = None

for line in lines:
    if line.startswith('[[package]]'):
        if current_name:
            if current_name not in packages:
                packages[current_name] = []
            packages[current_name].append(current_version)
        current_name = None
        current_version = None
    elif line.startswith('name = '):
        m = re.match(r'^name = \"(.*)\"$', line)
        if m:
            current_name = m.group(1)
    elif line.startswith('version = '):
        m = re.match(r'^version = \"(.*)\"$', line)
        if m:
            current_version = m.group(1)

if current_name:
    if current_name not in packages:
        packages[current_name] = []
    packages[current_name].append(current_version)

for name, versions in sorted(packages.items()):
    if len(versions) > 1:
        vs = sorted(set(versions))
        print(f'{name}: {len(vs)} versions -> {vs}')
