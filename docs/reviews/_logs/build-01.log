import re, sys

with open('Cargo.lock') as f:
    content = f.read()

# Parse packages
packages = {}
current_name = None
current = {}
for line in content.split('\n'):
    if line.startswith('[[package]]'):
        if current_name:
            if current_name in packages:
                packages[current_name].append(current)
            else:
                packages[current_name] = [current]
        current = {}
        current_name = None
    elif line.startswith('name = '):
        current_name = line.split('\"')[1]
    elif line.startswith('version = '):
        current['version'] = line.split('\"')[1]

if current_name:
    if current_name in packages:
        packages[current_name].append(current)
    else:
        packages[current_name] = [current]

# Find duplicates with different semver-major or extreme version differences
for name, versions in sorted(packages.items()):
    if len(versions) > 1:
        vs = sorted(set(v['version'] for v in versions))
        print(f'{name}: {vs}')
