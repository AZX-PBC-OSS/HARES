import decimal
D = decimal.Decimal

# Exact: 1 ft = 0.3048 m (exact by definition since 1959)
# 1 ft^3 = 0.3048^3 m^3
ft3_to_m3 = D('0.3048') ** 3
print('ft^3 to m^3 exact:', ft3_to_m3)

# CFM to m^3/s = ft^3/60 seconds
cfm_to_m3s = ft3_to_m3 / D('60')
print('CFM to m^3/s exact:', cfm_to_m3s)

# The constant in the code is 0.000_471_947_443_2
constant = D('0.0004719474432')
print()
print('Constant in code:', constant)
print('Difference:', cfm_to_m3s - constant)

# Show at high precision
import decimal
decimal.getcontext().prec = 40
