import math

def angle_of_incidence(tilt_deg, surface_azimuth_deg, solar_zenith_deg, solar_azimuth_deg):
    '''Duffie & Beckman Eq. 1.6.2 — AOI in radians'''
    beta = math.radians(tilt_deg)
    gamma = math.radians(surface_azimuth_deg)
    theta_z = math.radians(solar_zenith_deg)
    gamma_s = math.radians(solar_azimuth_deg)
    
    cos_aoi = (math.cos(theta_z) * math.cos(beta)
              + math.sin(theta_z) * math.sin(beta) * math.cos(gamma_s - gamma))
    return math.acos(max(-1.0, min(1.0, cos_aoi)))

def cos_aoi_clipped(tilt_deg, surface_azimuth_deg, solar_zenith_deg, solar_azimuth_deg):
    aoi = angle_of_incidence(tilt_deg, surface_azimuth_deg, solar_zenith_deg, solar_azimuth_deg)
    return max(0.0, math.cos(aoi))

def azimuth_average(n_samples, tilt_deg, solar_zenith_deg, solar_azimuth_deg):
    '''Average of max(0, cos(AOI)) over n_samples uniform azimuths'''
    total = 0.0
    for i in range(n_samples):
        az = i * 360.0 / n_samples
        total += cos_aoi_clipped(tilt_deg, az, solar_zenith_deg, solar_azimuth_deg)
    return total / n_samples

# Test across tilt angles and solar positions
tilts = [0, 15, 30, 45, 60, 75, 90]
zeniths = list(range(0, 90, 5))  # 0, 5, 10, ..., 85
azimuths = [0, 45, 90, 135, 180, 225, 270, 315]

print('='*100)
print('OMNI_AZIMUTH_SAMPLES=12 Integration Error Analysis')
print('Comparing N=12 vs N=720 azimuth samples for max(0, cos(AOI))')
print('='*100)

# Collect all errors for summary stats
all_abs_errors = {t: [] for t in tilts}
all_rel_errors = {t: [] for t in tilts}

for tilt in tilts:
    max_abs_err = 0.0
    max_rel_err = 0.0
    max_abs_case = None
    max_rel_case = None
    
    for z in zeniths:
        for sa in azimuths:
            val_12 = azimuth_average(12, tilt, z, sa)
            val_720 = azimuth_average(720, tilt, z, sa)
            
            abs_err = abs(val_12 - val_720)
            rel_err = abs_err / max(val_720, 1e-12) if val_720 > 1e-12 else 0.0
            
            all_abs_errors[tilt].append(abs_err)
            all_rel_errors[tilt].append(abs_err)  # same for now
            
            if abs_err > max_abs_err:
                max_abs_err = abs_err
                max_abs_case = (z, sa, val_12, val_720)
            if rel_err > max_rel_err and val_720 > 1e-6:
                max_rel_err = rel_err
                max_rel_case = (z, sa, val_12, val_720, rel_err)
    
    # Also track the worst-case relative error across all zeniths for this tilt
    # where val_720 > 1e-3 (avoid division by tiny numbers)
    sig_rel_errors = []
    for z in zeniths:
        for sa in azimuths:
            val_12 = azimuth_average(12, tilt, z, sa)
            val_720 = azimuth_average(720, tilt, z, sa)
            if val_720 > 1e-3:
                sig_rel_errors.append(abs(val_12 - val_720) / val_720)
    
    max_sig_rel = max(sig_rel_errors) if sig_rel_errors else 0.0
    mean_abs = sum(all_abs_errors[tilt]) / len(all_abs_errors[tilt])
    mean_sig_rel = sum(sig_rel_errors) / len(sig_rel_errors) if sig_rel_errors else 0.0
    
    print(f'\nTilt = {tilt}°:')
    print(f'  Max absolute error in avg[cos(AOI)]: {max_abs_err:.6f}')
    print(f'  Max relative error (significant values): {max_sig_rel*100:.4f}%')
    print(f'  Mean absolute error: {mean_abs:.6f}')
    print(f'  Mean relative error (significant): {mean_sig_rel*100:.4f}%')
    if max_abs_case:
        print(f'  Worst abs: zenith={max_abs_case[0]}°, sol_az={max_abs_case[1]}°, val_12={max_abs_case[2]:.6f}, val_720={max_abs_case[3]:.6f}')

