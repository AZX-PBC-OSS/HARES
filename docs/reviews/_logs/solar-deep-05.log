import math

def cos_aoi_avg(tilt_deg, surface_azimuth_deg, solar_zenith_deg, solar_azimuth_deg):
    beta = math.radians(tilt_deg)
    gamma = math.radians(surface_azimuth_deg)
    theta_z = math.radians(solar_zenith_deg)
    gamma_s = math.radians(solar_azimuth_deg)
    cos_aoi = (math.cos(theta_z) * math.cos(beta)
              + math.sin(theta_z) * math.sin(beta) * math.cos(gamma_s - gamma))
    return max(0.0, cos_aoi)

def azimuth_average(n, tilt, zen, saz):
    total = 0.0
    for i in range(n):
        total += cos_aoi_avg(tilt, i * 360.0 / n, zen, saz)
    return total / n

def analytical_vertical(zen_deg):
    return math.sin(math.radians(zen_deg)) / math.pi

# Verify the doc claim: N=12 converges to within 0.5% of DNI/pi
print('Verifying doc claim: \"N=12 sampling converges to within 0.5%\"')
print('For vertical walls, analytical avg[cos(AOI)] = sin(zen)/pi')
print()
for zen in [30, 45, 60, 75, 85]:
    analytic = analytical_vertical(zen)
    n12 = azimuth_average(12, 90, zen, 180)
    n12_err_pct = abs(n12 - analytic) / analytic * 100
    n24 = azimuth_average(24, 90, zen, 180)
    n24_err_pct = abs(n24 - analytic) / analytic * 100
    n36 = azimuth_average(36, 90, zen, 180)
    n36_err_pct = abs(n36 - analytic) / analytic * 100
    print(f'  zen={zen}°: analytic={analytic:.6f}, N=12={n12:.6f} ({n12_err_pct:.2f}% err), '
          f'N=24={n24:.6f} ({n24_err_pct:.2f}% err), N=36={n36:.6f} ({n36_err_pct:.2f}% err)')

print()
print('Maximum absolute error in avg[cos(AOI)] over zenith=10°..85°:')
for tilt in [0, 15, 30, 45, 60, 75, 90]:
    max_n12 = max(abs(azimuth_average(12, tilt, z, 0) - azimuth_average(720, tilt, z, 0)) for z in range(10,86,2))
    max_n24 = max(abs(azimuth_average(24, tilt, z, 0) - azimuth_average(720, tilt, z, 0)) for z in range(10,86,2))
    max_n36 = max(abs(azimuth_average(36, tilt, z, 0) - azimuth_average(720, tilt, z, 0)) for z in range(10,86,2))
    print(f'  tilt={tilt:3d}°: N=12 max_err={max_n12:.6f}, N=24 max_err={max_n24:.6f}, N=36 max_err={max_n36:.6f}')

# Check: what number of samples gives <0.5% error for tilt=90° over all zeniths?
print()
print('Samples needed for <0.5% max relative error on vertical wall:')
for n in [12, 18, 24, 30, 36, 48, 60, 72, 90, 120, 180, 360]:
    max_rel_err = 0.0
    for z in range(10, 86, 2):
        a = analytical_vertical(z)
        v = azimuth_average(n, 90, z, 0)
        if a > 1e-4:
            max_rel_err = max(max_rel_err, abs(v - a) / a)
    print(f'  N={n:4d}: max_rel_err={max_rel_err*100:.4f}% {\"< 0.5%\" if max_rel_err < 0.005 else \"\"} ')
