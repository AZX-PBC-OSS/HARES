import math

def angle_of_incidence(tilt_deg, surface_azimuth_deg, solar_zenith_deg, solar_azimuth_deg):
    beta = math.radians(tilt_deg)
    gamma = math.radians(surface_azimuth_deg)
    theta_z = math.radians(solar_zenith_deg)
    gamma_s = math.radians(solar_azimuth_deg)
    cos_aoi = (math.cos(theta_z) * math.cos(beta)
              + math.sin(theta_z) * math.sin(beta) * math.cos(gamma_s - gamma))
    return math.acos(max(-1.0, min(1.0, cos_aoi)))

def cos_aoi_clipped(tilt_deg, surface_azimuth_deg, solar_zenith_deg, solar_azimuth_deg):
    aoi = angle_of_incidence(tilt_deg, surface_azimuth_deg, solar_zenith_deg, solar_azimuth_deg)
    return max(0.0, math.cos(aoi))

def azimuth_average(n_samples, tilt_deg, solar_zenith_deg, solar_azimuth_deg):
    total = 0.0
    for i in range(n_samples):
        az = i * 360.0 / n_samples
        total += cos_aoi_clipped(tilt_deg, az, solar_zenith_deg, solar_azimuth_deg)
    return total / n_samples

# Analytical: For vertical walls (tilt=90°), azimuth-averaged cos(AOI) = sin(zenith) / pi
# For horizontal (tilt=0°), azimuth-averaged cos(AOI) = cos(zenith)
def analytical_vertical(z):
    return math.sin(math.radians(z)) / math.pi

# More thorough analysis with realistic irradiance values
tilts = [0, 15, 30, 45, 60, 75, 90]

# All solar zenith angles from 10 to 85 degrees
zeniths = list(range(10, 86, 2))

# Solar azimuth doesn't matter for azimuth averaging since we integrate over all surface azimuths
# (the result is periodic and independent of solar azimuth)

print('=' * 100)
print('DETAILED ANALYSIS: OMNI_AZIMUTH_SAMPLES=12 vs N=720 reference')
print('=' * 100)

for tilt in tilts:
    abs_errors = []
    rel_errors = []
    val_12_list = []
    val_720_list = []
    
    for z in zeniths:
        v12 = azimuth_average(12, tilt, z, 180)  # solar azimuth doesn't matter
        v720 = azimuth_average(720, tilt, z, 180)
        abs_errors.append(abs(v12 - v720))
        val_12_list.append(v12)
        val_720_list.append(v720)
        if v720 > 1e-4:
            rel_errors.append(abs(v12 - v720) / v720)
    
    max_abs = max(abs_errors)
    max_rel = max(rel_errors) if rel_errors else 0
    mean_abs = sum(abs_errors) / len(abs_errors)
    mean_rel = sum(rel_errors) / len(rel_errors) if rel_errors else 0
    rms_abs = math.sqrt(sum(e*e for e in abs_errors) / len(abs_errors))
    
    # Worst-case irradiance impact
    # At DNI=1000 W/m2 (clear sky), direct error = DNI * max_abs_err
    worst_direct_err = 1000 * max_abs
    # At DHI=300, F1~0.3 (clear), b~0.2 (low sun), circumsolar error:
    worst_circum_err = 300 * 0.3 * max_abs / 0.2 if max_abs > 0 else 0
    total_worst = worst_direct_err + worst_circum_err
    
    print(f'\nTilt {tilt:3d}°:')
    print(f'  avg[cos(AOI)] range: [{min(val_720_list):.4f}, {max(val_720_list):.4f}]')
    print(f'  Max abs error:  {max_abs:.6f}')
    print(f'  Max rel error:  {max_rel*100:.3f}%')
    print(f'  Mean abs error: {mean_abs:.6f}')
    print(f'  Mean rel error: {mean_rel*100:.3f}%')
    print(f'  RMS abs error:  {rms_abs:.6f}')
    print(f'  Worst direct err @ DNI=1000:  {worst_direct_err:.1f} W/m²')
    print(f'  Worst circum err @ DHI=300:    {worst_circum_err:.1f} W/m²')
    print(f'  Worst-case combined:           {total_worst:.1f} W/m²')

# Verify vertical wall analytical claim
print()
print('=' * 100)
print('VERTICAL WALL (tilt=90°) ANALYTICAL VERIFICATION')
print('Analytical: avg[cos(AOI)] = sin(zenith) / pi')
print('=' * 100)
print(f'{\"Zenith\":>8} {\"N=12\":>10} {\"N=720\":>10} {\"Analytical\":>12} {\"N12-err\":>10} {\"N720-err\":>10}')
for z in [10, 20, 30, 40, 50, 60, 70, 80, 85]:
    v12 = azimuth_average(12, 90, z, 180)
    v720 = azimuth_average(720, 90, z, 180)
    analytic = analytical_vertical(z)
    print(f'{z:8.1f} {v12:10.6f} {v720:10.6f} {analytic:12.6f} {abs(v12-analytic):10.6f} {abs(v720-analytic):10.6f}')

print()
print('=' * 100)
print('IRRADIANCE-LEVEL ERROR QUANTIFICATION')
print('Typical mid-latitude clear-sky conditions: DNI=850, DHI=150, GHI=1000')
print('=' * 100)

# Perez F1 values: ~0.1-0.3 for clear conditions with moderate sun
# F2 values: ~ -0.05 to 0.05
# b = max(cos(zenith), cos(85°)) for Perez

for tilt in tilts:
    worst_abs_cosaoi = max(abs(
        azimuth_average(12, tilt, z, 180) - azimuth_average(720, tilt, z, 180)
    ) for z in zeniths)
    
    # For the worst zenith angle at this tilt, compute full irradiance error
    # using the Perez model decomposition
    worst_z = max(zeniths, key=lambda z: abs(
        azimuth_average(12, tilt, z, 180) - azimuth_average(720, tilt, z, 180)
    ))
    
    # Perez F1 for clear sky with moderate zenith ~0.25
    f1 = 0.25
    b_val = max(math.cos(math.radians(worst_z)), 0.087156)  # COS_85_DEG
    
    # Error terms:
    # Direct: DNI * cos_aoi_err
    # Circumsolar: DHI * F1 * cos_aoi_err / b
    dni, dhi = 850.0, 150.0
    direct_err = dni * worst_abs_cosaoi
    circum_err = dhi * f1 * worst_abs_cosaoi / b_val
    total_err = direct_err + circum_err
    typical_total = 1000.0  # rough POA estimate
    
    print(f'  Tilt {tilt:3d}°: worst zenith={worst_z}°, cos_aoi_err={worst_abs_cosaoi:.6f}, '
          f'direct_err={direct_err:.2f}, circum_err={circum_err:.2f}, total_err={total_err:.2f} W/m²')
