print("=== Z+I+P Sum Verification ===")
bad_p = 0
bad_q = 0
for name, (zp, ip, pp, zq, iq, pq, pf) in sorted(data.items()):
    sum_p = zp + ip + pp
    sum_q = zq + iq + pq
    p_ok = abs(sum_p - 1.0) < 1e-12
    q_ok = abs(sum_q - 1.0) < 1e-12
    if not p_ok or not q_ok:
        print(f"  FAIL: {name}  P={sum_p:.10f}  Q={sum_q:.10f}")
        if not p_ok: bad_p += 1
        if not q_ok: bad_q += 1
print(f"  P sum violations: {bad_p}, Q sum violations: {bad_q}")

print("\n=== PF Interpretation Comparison ===")
print("  Scheduled load: Q = P * pf (raw scalar)")
print("  Water heater:   Q = P * tan(acos(pf))")
for name, (zp, ip, pp, zq, iq, pq, pf) in sorted(data.items()):
    raw = pf
    correct = tan(acos(min(max(pf, 0.0001), 0.9999)))
    diff = abs(raw - correct)
    if diff > 0.001:
        marker = " *** DIFF" if diff > 0.05 else ""
        print(f"  {name:35s} pf={pf:.2f}  raw={raw:.4f}  tan(acos(pf))={correct:.4f}  Δ={diff:.4f}{marker}")

print("\n=== OCHRE vs HARES at v=0.95 pu ===")
for name in ["ashp_heater", "air_conditioner", "refrigerator"]:
    zp, ip, pp, zq, iq, pq, pf = data[name]
    v = 0.95
    # HARES WH: real→real, reactive→reactive
    hares_real = zp*v*v + ip*v + pp
    hares_react = zq*v*v + iq*v + pq
    # OCHRE: real→reactive coefficients, reactive→real coefficients
    ochre_real = zq*v*v + iq*v + pq
    ochre_react = zp*v*v + ip*v + pp
    print(f"  {name}: HARES real={hares_real:.4f} react={hares_react:.4f} | OCHRE real={ochre_real:.4f} react={ochre_react:.4f}")

print("\n=== Large-Magnitude Coefficients (>2 magnitude) ===")
for name, (zp, ip, pp, zq, iq, pq, pf) in sorted(data.items()):
    max_abs = max(abs(zp), abs(ip), abs(pp), abs(zq), abs(iq), abs(pq))
    if max_abs > 2:
        print(f"  {name:35s} max|coeff|={max_abs:.1f}  zp={zp}  ip={ip}  pp={pp}  zq={zq}  iq={iq}  pq={pq}")
