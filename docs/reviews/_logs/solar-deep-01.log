import math
import pvlib.solarposition as sp
from datetime import datetime, timezone
import pandas as pd

# Test a known case
lat, lon = 40, -105
dt = datetime(2024, 3, 20, 12, 0, tzinfo=timezone.utc)
h = dt.hour

# HARES declination
day = dt.timetuple().tm_yday
minutes_utc = h * 60.0
gamma = 2.0 * math.pi / 365.0 * (day - 1.0 + (minutes_utc - 720.0) / 1440.0)
decl_h = (0.006918 - 0.399912*math.cos(gamma) + 0.070257*math.sin(gamma)
          - 0.006758*math.cos(2*gamma) + 0.000907*math.sin(2*gamma)
          - 0.002697*math.cos(3*gamma) + 0.00148*math.sin(3*gamma))
print(f'HARES declination rad: {decl_h:.6f}   deg: {math.degrees(decl_h):.4f}')

# pvlib Spencer
decl_pv = sp.declination_spencer71(day)
print(f'pvlib Spencer decl rad: {decl_pv:.6f}   deg: {math.degrees(decl_pv):.4f}')
print(f'Delta (deg): {abs(math.degrees(decl_h) - math.degrees(decl_pv)):.8f}')

# Now test SPA
times = pd.DatetimeIndex([pd.Timestamp(dt)])
solpos = sp.get_solarposition(times, lat, lon, method='nrel_numpy')
zenith = solpos['zenith'].values[0]
print(f'\\nSPA zenith: {zenith:.6f}°')
print(f'SPA cos(zenith): {math.cos(math.radians(zenith)):.6f}')

# Compute SPA hour angle from EOT
eot = solpos['equation_of_time'].values[0]
HA_deg = (h + eot/60.0 + lon/15.0 - 12.0) * 15.0
HA_rad = math.radians(HA_deg)
print(f'EOT: {eot:.4f} min, Hour angle: {HA_deg:.4f}°')

# Back-calculate declination
lat_rad = math.radians(lat)
CZ = math.cos(math.radians(zenith))
A = math.sin(lat_rad)
B = math.cos(lat_rad) * math.cos(HA_rad)
C = CZ
R = math.sqrt(A*A + B*B)
decl = math.asin(max(-1, min(1, C/R))) - math.atan2(B, A)
print(f'Back-calculated SPA decl: {math.degrees(decl):.4f}°')
print(f'SPA zenith: {zenith:.4f}°')
print(f'Check: cos(zenith) = sin(lat)*sin(decl)+... = '
      f'{math.sin(lat_rad)*math.sin(decl) + math.cos(lat_rad)*math.cos(decl)*math.cos(HA_rad):.6f}')
print(f'  vs CZ = {CZ:.6f}')

# Try with two-argument version:
# decl = CZ*A ± B*sqrt(A² + B² - CZ²) all over (A² + B²)
# Actually use atan2 approach more carefully:
# sin(decl+phi) = CZ/R where tan(phi) = B/A
phi = math.atan2(B, A)
tmp = CZ / R
decl2 = math.asin(max(-1, min(1, tmp))) - phi
print(f'Decl method 2: {math.degrees(decl2):.4f}°')

# Verify
print(f'\\nVerification:')
for d_test in [math.radians(-0.25), math.radians(0), math.radians(0.25), math.radians(23), math.radians(-23)]:
    cz_test = math.sin(lat_rad)*math.sin(d_test) + math.cos(lat_rad)*math.cos(d_test)*math.cos(HA_rad)
    A = math.sin(lat_rad)
    B = math.cos(lat_rad) * math.cos(HA_rad)
    R = math.sqrt(A*A + B*B)
    phi = math.atan2(B, A)
    d_back = math.asin(max(-1, min(1, cz_test/R))) - phi
    print(f'  True decl={math.degrees(d_test):.1f}° -> back-calc={math.degrees(d_back):.4f}°')
"
