import math, pvlib
from datetime import datetime, timezone

# HARES formula includes intra-day fraction in gamma
# pvlib Spencer uses integer day-of-year only

DAYS_PER_YEAR = 365.0
SOLAR_NOON_MINUTES = 720.0
MINUTES_PER_DAY = 1440.0

EOT_C0 = 0.000_007_5; EOT_C1 = 0.001_868; EOT_C2 = -0.032_077
EOT_C3 = -0.014_615; EOT_C4 = -0.040_849
EOT_SCALE = 229.18

DECL_C0 = 0.006_918; DECL_C1 = -0.399_912; DECL_C2 = 0.070_257
DECL_C3 = -0.006_758; DECL_C4 = 0.000_907; DECL_C5 = -0.002_697; DECL_C6 = 0.001_48

def hares_at_hour(day, h):
    \"\"\"HARES formula at given day and UTC hour\"\"\"
    minutes_utc = h * 60.0
    gamma = 2*math.pi/DAYS_PER_YEAR * (day-1 + (minutes_utc - SOLAR_NOON_MINUTES)/MINUTES_PER_DAY)
    decl = (DECL_C0 + DECL_C1*math.cos(gamma) + DECL_C2*math.sin(gamma)
            + DECL_C3*math.cos(2*gamma) + DECL_C4*math.sin(2*gamma)
            + DECL_C5*math.cos(3*gamma) + DECL_C6*math.sin(3*gamma))
    eot = EOT_SCALE * (EOT_C0 + EOT_C1*math.cos(gamma) + EOT_C2*math.sin(gamma)
                       + EOT_C3*math.cos(2*gamma) + EOT_C4*math.sin(2*gamma))
    return math.degrees(decl), eot

def hares_at_noon(day):
    \"\"\"HARES formula at solar noon (minutes_utc=720)\"\"\"
    gamma = 2*math.pi/DAYS_PER_YEAR * (day - 1)
    decl = (DECL_C0 + DECL_C1*math.cos(gamma) + DECL_C2*math.sin(gamma)
            + DECL_C3*math.cos(2*gamma) + DECL_C4*math.sin(2*gamma)
            + DECL_C5*math.cos(3*gamma) + DECL_C6*math.sin(3*gamma))
    eot = EOT_SCALE * (EOT_C0 + EOT_C1*math.cos(gamma) + EOT_C2*math.sin(gamma)
                       + EOT_C3*math.cos(2*gamma) + EOT_C4*math.sin(2*gamma))
    return math.degrees(decl), eot

# Compare at various times
for day in [80, 172, 266, 355]:  # equinox, solstice, equinox, solstice days in 2024
    for h in [0, 6, 12, 18]:
        d_h, e_h = hares_at_hour(day, h)
        d_n, e_n = hares_at_noon(day)
        d_pv = math.degrees(pvlib.solarposition.declination_spencer71(day))
        e_pv = pvlib.solarposition.equation_of_time_spencer71(day)
        
        # HARES at noon should match pvlib exactly (same day-angle)
        delta_noon = abs(d_n - d_pv)
        delta_hour = abs(d_h - d_pv)
        delta_eot_noon = abs(e_n - e_pv)
        delta_eot_hour = abs(e_h - e_pv)
        
        print(f'day={day:3d} h={h:2d}:  HARES decl={d_h:8.4f}  '
              f'noon_decl={d_n:8.4f}  pvlib={d_pv:8.4f}  '
              f'diff_noon={delta_noon:.2e}  diff_hour={delta_hour:.2e}  '
              f'd_eot_noon={delta_eot_noon:.2e}')
    
    print(f'--- pvlib eot={e_pv:.4f}, HARES noon eot={e_n:.4f}, diff={abs(e_n-e_pv):.2e}')
    print()
