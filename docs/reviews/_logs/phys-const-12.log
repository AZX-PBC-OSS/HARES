import struct

def f64_from_decimal(s):
    '''Convert decimal string to f64 bits'''
    val = float(s)
    bits = struct.unpack('<Q', struct.pack('<d', val))[0]
    return bits

# True f64 nearest
true_bits = f64_from_decimal(str(12000 * 1055.05585262 / 3600))
print(f'True nearest f64: {true_bits:#018x}')

# Check various candidate literals
candidates = [
    '3516.852842066666',
    '3516.8528420666665',
    '3516.8528420666666',
    '3516.8528420666667',
    '3516.8528420666668',
    '3516.8528420666669',
    '3516.852842066667',
]
for c in candidates:
    bits = f64_from_decimal(c)
    val = float(c)
    match = 'CORRECT' if bits == true_bits else 'WRONG'
    print(f'  literal={c:<26} -> hex={bits:#018x}  val={val:.30f}  {match}')
