seconds_per_hour = 3600

w_per_ton = btu_per_h * btu_to_j / seconds_per_hour
print(f'12000 * {btu_to_j} / 3600 = {w_per_ton}')
print(f'Full precision: {w_per_ton:.50f}')

# The HARES constant
hares_val = 3516.852842066667
