[0m$ [0mpython3 -c "
# Verify ASHRAE 90.1-2022 Table A6.3.1 F-factor conversions
# Conversion: 1 Btu/(h·ft·°F) = 1.730734666... W/(m·K)
# HARES uses 1.73074

conv = 1.73074

# Standard ASHRAE values for 2ft vertical insulation (Btu/h·ft·°F)
ashrae_ip = {
    ('uninsulated', 'unheated'): 0.73,
    ('R-5', 'unheated'): 0.72,
    ('R-10', 'unheated'): 0.71,
    ('uninsulated', 'heated'): 1.35,
    ('R-5', 'heated'): 1.31,
    ('R-10', 'heated'): 1.30,
}

# HARES code values
hares_si = {
    ('uninsulated', 'unheated'): 1.263,
    ('R-5', 'unheated'): 1.246,
    ('R-10', 'unheated'): 1.229,
    ('uninsulated', 'heated'): 2.336,
    ('R-5', 'heated'): 2.267,
    ('R-10', 'heated'): 2.250,
}

print('=== F2 Coefficient Verification ===')
print(f'Conversion factor: {conv} W/(m·K) per Btu/(h·ft·°F)')
print()
print(f'{\"Insulation\":<15} {\"Heated?\":<10} {\"ASHRAE IP\":>12} {\"Computed SI\":>12} {\"HARES SI\":>10} {\"Match?\":>8}')
print('-' * 72)

all_match = True
for (insul, heated), ip_val in ashrae_ip.items():
    computed = round(ip_val * conv, 3)
    hares = hares_si[(insul, heated)]
    match = 'YES' if computed == hares else 'NO'
    if match == 'NO':
        all_match = False
    print(f'{insul:<15} {heated:<10} {ip_val:>12.2f} {computed:>12.3f} {hares:>10.3f} {match:>8}')

# Also verify with exact conversion
print()
print('=== With exact conversion factor (1.730734666...) ===')
conv_exact = 1.7307346666666667
for (insul, heated), ip_val in ashrae_ip.items():
    computed_exact = ip_val * conv_exact
    hares = hares_si[(insul, heated)]
    diff = abs(computed_exact - hares)
    rel_err = diff / computed_exact * 100
    print(f'{insul:<15} {heated:<10} exact={computed_exact:.6f} hares={hares:.3f} diff={diff:.6f} rel_err={rel_err:.4f}%')

# R-value threshold verification
print()
print('=== R-Value Threshold Verification ===')
print(f'R-5 IP = 5 h·ft²·°F/Btu × 0.17611 = {5*0.17611:.5f} m²·K/W → rounded to 0.88')
print(f'R-10 IP = 10 h·ft²·°F/Btu × 0.17611 = {10*0.17611:.5f} m²·K/W → rounded to 1.76')
print(f'Exact: R-5 = {5*0.1761101845:.6f}, R-10 = {10*0.1761101845:.6f}')
"

