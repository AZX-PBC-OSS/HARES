OS:OtherEquipment:Definition,
  {630b1e36-a0d1-4f6a-a356-c33c9cf63e54}, !- Handle
  mech vent house fan latent load,        !- Name
  EquipmentLevel,                         !- Design Level Calculation Method
  0,                                      !- Design Level {W}
