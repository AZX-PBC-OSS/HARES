OS:EnergyManagementSystem:Program,
  {ff2c984b-76e9-4360-8352-5e64d621ea18}, !- Handle
  water_heater_InletAir,                  !- Name
  Set water_heater_Tamb_act = water_heater_amb_temp, !- Program Line 1
  Set water_heater_RHamb_act = 0,         !- Program Line 2
  Set water_heater_RHamb_act = water_heater_RHamb_act + (water_heater_amb1_rh / 100) / 2, !- Program Line 3
  Set water_heater_RHamb_act = water_heater_RHamb_act + (water_heater_amb2_rh / 100) / 2; !- Program Line 4

