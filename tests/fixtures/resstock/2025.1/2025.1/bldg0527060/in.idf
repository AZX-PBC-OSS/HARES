  Set loads_clg_whf = 0,                  !- Program Line 39
  Set loads_clg_ducts = 0,                !- Program Line 40
  Set hr_walls = 0,                       !- Program Line 41
  Set hr_walls = hr_walls + s_conv_2 + s_ig_2 + s_sol_2 + s_lgt_2 + s_surf_2, !- Program Line 42
  Set hr_walls = hr_walls + s_conv_3 + s_ig_3 + s_sol_3 + s_lgt_3 + s_surf_3, !- Program Line 43
  Set hr_walls = hr_walls + s_conv_4 + s_ig_4 + s_sol_4 + s_lgt_4 + s_surf_4, !- Program Line 44
  Set hr_walls = hr_walls + s_conv_5 + s_ig_5 + s_sol_5 + s_lgt_5 + s_surf_5, !- Program Line 45
  Set hr_rim_joists = 0,                  !- Program Line 46
  Set hr_foundation_walls = 0,            !- Program Line 47
  Set hr_floors = 0,                      !- Program Line 48
  Set hr_floors = hr_floors + s_conv + s_ig + s_sol + s_lgt + s_surf, !- Program Line 49
  Set hr_slabs = 0,                       !- Program Line 50
  Set hr_ceilings = 0,                    !- Program Line 51
  Set hr_ceilings = hr_ceilings + s_conv_1 + s_ig_1 + s_sol_1 + s_lgt_1 + s_surf_1, !- Program Line 52
  Set hr_roofs = 0,                       !- Program Line 53
  Set hr_windows_conduction = 0,          !- Program Line 54
  Set hr_windows_conduction = hr_windows_conduction + ss_conv, !- Program Line 55
  Set hr_windows_conduction = hr_windows_conduction + ss_ig, !- Program Line 56
  Set hr_windows_conduction = hr_windows_conduction + ss_surf, !- Program Line 57
  Set hr_windows_solar = 0,               !- Program Line 58
  Set hr_windows_solar = hr_windows_solar - ss_trans_in * ZoneTimestep * 3600 + ss_back_out * ZoneTimestep * 3600 + ss_trans_out * ZoneTimestep * 3600, !- Program Line 59
  Set hr_doors = 0,                       !- Program Line 60
  Set hr_skylights_conduction = 0,        !- Program Line 61
  Set hr_skylights_solar = 0,             !- Program Line 62
  Set hr_internal_mass = 0,               !- Program Line 63
  Set hr_internal_mass = hr_internal_mass + im_conv + im_ig + im_sol + im_lgt + im_surf, !- Program Line 64
  Set hr_internal_mass = hr_internal_mass + im_conv_1 + im_ig_1 + im_sol_1 + im_lgt_1 + im_surf_1, !- Program Line 65
  Set hr_intgains = 0,                    !- Program Line 66
  Set hr_intgains = hr_intgains - ig_ee_conv - ig_ee_rad - ig_ee_conv_1 - ig_ee_rad_1 - ig_ee_conv_2 - ig_ee_rad_2 - ig_ee_conv_3 - ig_ee_rad_3 - ig_ee_conv_4 - ig_ee_rad_4 - ig_ee_conv_5 - ig_ee_rad_5 - ig_oe_conv - ig_oe_rad - ig_oe_conv_1 - ig_oe_rad_1 - ig_oe_conv_2 - ig_oe_rad_2 - ig_oe_conv_3 - ig_oe_rad_3 - ig_oe_conv_4 - ig_oe_rad_4, !- Program Line 67
  Set hr_lighting = 0,                    !- Program Line 68
  Set hr_infil = 0,                       !- Program Line 69
  Set hr_infil = hr_infil - airflow_gain + airflow_loss, !- Program Line 70
  Set hr_natvent = 0,                     !- Program Line 71
  Set hr_natvent = hr_natvent - airflow_gain_1 + airflow_loss_1, !- Program Line 72
  Set hr_whf = 0,                         !- Program Line 73
  Set hr_whf = hr_whf - airflow_gain_2 + airflow_loss_2, !- Program Line 74
  Set hr_mechvent = 0,                    !- Program Line 75
  Set hr_mechvent = hr_mechvent - mv_conv - mv_rad - mv_conv_1 - mv_rad_1 - mv_conv_2 - mv_rad_2 - mv_conv_3 - mv_rad_3, !- Program Line 76
  Set hr_ducts = 0,                       !- Program Line 77
  Set htg_mode = 0,                       !- Program Line 78
  Set clg_mode = 0,                       !- Program Line 79
  If (htg_load_cond > 0),                 !- Program Line 80
  Set htg_mode = 1.0,                     !- Program Line 81
  ElseIf (clg_load_cond > 0),             !- Program Line 82
  Set clg_mode = 0.4,                     !- Program Line 83
  Else,                                   !- Program Line 84
  Set htg_season = 0,                     !- Program Line 85
  Set clg_season = 0,                     !- Program Line 86
  If ((DayOfYear >= 1) && (DayOfYear <= 365)), !- Program Line 87
  Set clg_season = 1,                     !- Program Line 88
  EndIf,                                  !- Program Line 89
  If ((DayOfYear >= 1) && (DayOfYear <= 365)), !- Program Line 90
  Set htg_season = 1,                     !- Program Line 91
  EndIf,                                  !- Program Line 92
  If ((airflow_gain_1 <> 0) || (airflow_loss_1 <> 0)) && (clg_season == 1), !- Program Line 93
  Set clg_mode = 0.4,                     !- Program Line 94
  ElseIf ((airflow_gain_2 <> 0) || (airflow_loss_2 <> 0)) && (clg_season == 1), !- Program Line 95
  Set clg_mode = 0.4,                     !- Program Line 96
  Else,                                   !- Program Line 97
  Set Tmid_setpoint = (htg_sp_s_1 + clg_sp_s_1) / 2, !- Program Line 98
  If (tin_s_1 > Tmid_setpoint) && (clg_season == 1), !- Program Line 99
  Set clg_mode = 0.4,                     !- Program Line 100
  ElseIf (tin_s_1 < Tmid_setpoint) && (htg_season == 1), !- Program Line 101
  Set htg_mode = 1.0,                     !- Program Line 102
  EndIf,                                  !- Program Line 103
  EndIf,                                  !- Program Line 104
  EndIf,                                  !- Program Line 105
  Set loads_htg_walls = loads_htg_walls + (hr_walls * htg_mode * 1), !- Program Line 106
  Set loads_htg_rim_joists = loads_htg_rim_joists + (hr_rim_joists * htg_mode * 1), !- Program Line 107
  Set loads_htg_foundation_walls = loads_htg_foundation_walls + (hr_foundation_walls * htg_mode * 1), !- Program Line 108
  Set loads_htg_floors = loads_htg_floors + (hr_floors * htg_mode * 1), !- Program Line 109
  Set loads_htg_slabs = loads_htg_slabs + (hr_slabs * htg_mode * 1), !- Program Line 110
  Set loads_htg_ceilings = loads_htg_ceilings + (hr_ceilings * htg_mode * 1), !- Program Line 111
  Set loads_htg_roofs = loads_htg_roofs + (hr_roofs * htg_mode * 1), !- Program Line 112
  Set loads_htg_windows_conduction = loads_htg_windows_conduction + (hr_windows_conduction * htg_mode * 1), !- Program Line 113
  Set loads_htg_windows_solar = loads_htg_windows_solar + (hr_windows_solar * htg_mode * 1), !- Program Line 114
  Set loads_htg_doors = loads_htg_doors + (hr_doors * htg_mode * 1), !- Program Line 115
  Set loads_htg_skylights_conduction = loads_htg_skylights_conduction + (hr_skylights_conduction * htg_mode * 1), !- Program Line 116
  Set loads_htg_skylights_solar = loads_htg_skylights_solar + (hr_skylights_solar * htg_mode * 1), !- Program Line 117
  Set loads_htg_internal_mass = loads_htg_internal_mass + (hr_internal_mass * htg_mode * 1), !- Program Line 118
  Set loads_htg_intgains = loads_htg_intgains + (hr_intgains * htg_mode * 1), !- Program Line 119
  Set loads_htg_lighting = loads_htg_lighting + (hr_lighting * htg_mode * 1), !- Program Line 120
  Set loads_htg_infil = loads_htg_infil + (hr_infil * htg_mode * 1), !- Program Line 121
  Set loads_htg_mechvent = loads_htg_mechvent + (hr_mechvent * htg_mode * 1), !- Program Line 122
  Set loads_htg_natvent = loads_htg_natvent + (hr_natvent * htg_mode * 1), !- Program Line 123
  Set loads_htg_whf = loads_htg_whf + (hr_whf * htg_mode * 1), !- Program Line 124
  Set loads_htg_ducts = loads_htg_ducts + (hr_ducts * htg_mode * 1), !- Program Line 125
  Set loads_clg_walls = loads_clg_walls + (-hr_walls * clg_mode * 1), !- Program Line 126
  Set loads_clg_rim_joists = loads_clg_rim_joists + (-hr_rim_joists * clg_mode * 1), !- Program Line 127
  Set loads_clg_foundation_walls = loads_clg_foundation_walls + (-hr_foundation_walls * clg_mode * 1), !- Program Line 128
  Set loads_clg_floors = loads_clg_floors + (-hr_floors * clg_mode * 1), !- Program Line 129
  Set loads_clg_slabs = loads_clg_slabs + (-hr_slabs * clg_mode * 1), !- Program Line 130
  Set loads_clg_ceilings = loads_clg_ceilings + (-hr_ceilings * clg_mode * 1), !- Program Line 131
  Set loads_clg_roofs = loads_clg_roofs + (-hr_roofs * clg_mode * 1), !- Program Line 132
  Set loads_clg_windows_conduction = loads_clg_windows_conduction + (-hr_windows_conduction * clg_mode * 1), !- Program Line 133
  Set loads_clg_windows_solar = loads_clg_windows_solar + (-hr_windows_solar * clg_mode * 1), !- Program Line 134
  Set loads_clg_doors = loads_clg_doors + (-hr_doors * clg_mode * 1), !- Program Line 135
  Set loads_clg_skylights_conduction = loads_clg_skylights_conduction + (-hr_skylights_conduction * clg_mode * 1), !- Program Line 136
  Set loads_clg_skylights_solar = loads_clg_skylights_solar + (-hr_skylights_solar * clg_mode * 1), !- Program Line 137
  Set loads_clg_internal_mass = loads_clg_internal_mass + (-hr_internal_mass * clg_mode * 1), !- Program Line 138
  Set loads_clg_intgains = loads_clg_intgains + (-hr_intgains * clg_mode * 1), !- Program Line 139
  Set loads_clg_lighting = loads_clg_lighting + (-hr_lighting * clg_mode * 1), !- Program Line 140
  Set loads_clg_infil = loads_clg_infil + (-hr_infil * clg_mode * 1), !- Program Line 141
  Set loads_clg_mechvent = loads_clg_mechvent + (-hr_mechvent * clg_mode * 1), !- Program Line 142
  Set loads_clg_natvent = loads_clg_natvent + (-hr_natvent * clg_mode * 1), !- Program Line 143
  Set loads_clg_whf = loads_clg_whf + (-hr_whf * clg_mode * 1), !- Program Line 144
  Set loads_clg_ducts = loads_clg_ducts + (-hr_ducts * clg_mode * 1); !- Program Line 145

EnergyManagementSystem:Program,
  fridge_schedule_program,                !- Name
  Set Tin = fridge_tin_s*(9.0/5.0)+32.0,  !- Program Line 1
  Set fridge_schedule_act = 0,            !- Program Line 2
  If (Hour == 0),                         !- Program Line 3
  Set fridge_schedule_act = (-0.487+0.019*Tin), !- Program Line 4
  ElseIf (Hour == 1),                     !- Program Line 5
  Set fridge_schedule_act = (-0.34+0.016*Tin), !- Program Line 6
  ElseIf (Hour == 2),                     !- Program Line 7
  Set fridge_schedule_act = (-0.37+0.017*Tin), !- Program Line 8
  ElseIf (Hour == 3),                     !- Program Line 9
  Set fridge_schedule_act = (-0.361+0.016*Tin), !- Program Line 10
  ElseIf (Hour == 4),                     !- Program Line 11
  Set fridge_schedule_act = (-0.515+0.018*Tin), !- Program Line 12
  ElseIf (Hour == 5),                     !- Program Line 13
  Set fridge_schedule_act = (-0.684+0.021*Tin), !- Program Line 14
  ElseIf (Hour == 6),                     !- Program Line 15
  Set fridge_schedule_act = (-0.471+0.019*Tin), !- Program Line 16
  ElseIf (Hour == 7),                     !- Program Line 17
  Set fridge_schedule_act = (-0.159+0.015*Tin), !- Program Line 18
  ElseIf (Hour == 8),                     !- Program Line 19
  Set fridge_schedule_act = (-0.079+0.015*Tin), !- Program Line 20
  ElseIf (Hour == 9),                     !- Program Line 21
  Set fridge_schedule_act = (-0.417+0.019*Tin), !- Program Line 22
  ElseIf (Hour == 10),                    !- Program Line 23
  Set fridge_schedule_act = (-0.411+0.018*Tin), !- Program Line 24
  ElseIf (Hour == 11),                    !- Program Line 25
  Set fridge_schedule_act = (-0.386+0.018*Tin), !- Program Line 26
  ElseIf (Hour == 12),                    !- Program Line 27
  Set fridge_schedule_act = (-0.24+0.016*Tin), !- Program Line 28
  ElseIf (Hour == 13),                    !- Program Line 29
  Set fridge_schedule_act = (-0.314+0.017*Tin), !- Program Line 30
  ElseIf (Hour == 14),                    !- Program Line 31
  Set fridge_schedule_act = (-0.16+0.015*Tin), !- Program Line 32
  ElseIf (Hour == 15),                    !- Program Line 33
  Set fridge_schedule_act = (-0.121+0.015*Tin), !- Program Line 34
  ElseIf (Hour == 16),                    !- Program Line 35
  Set fridge_schedule_act = (-0.469+0.02*Tin), !- Program Line 36
  ElseIf (Hour == 17),                    !- Program Line 37
  Set fridge_schedule_act = (-0.412+0.02*Tin), !- Program Line 38
  ElseIf (Hour == 18),                    !- Program Line 39
  Set fridge_schedule_act = (-0.091+0.017*Tin), !- Program Line 40
  ElseIf (Hour == 19),                    !- Program Line 41
  Set fridge_schedule_act = (0.077+0.014*Tin), !- Program Line 42
  ElseIf (Hour == 20),                    !- Program Line 43
  Set fridge_schedule_act = (-0.118+0.016*Tin), !- Program Line 44
  ElseIf (Hour == 21),                    !- Program Line 45
  Set fridge_schedule_act = (-0.247+0.017*Tin), !- Program Line 46
  ElseIf (Hour == 22),                    !- Program Line 47
  Set fridge_schedule_act = (-0.445+0.019*Tin), !- Program Line 48
  ElseIf (Hour == 23),                    !- Program Line 49
  Set fridge_schedule_act = (-0.544+0.02*Tin), !- Program Line 50
  EndIf;                                  !- Program Line 51

EnergyManagementSystem:Program,
  infil_program,                          !- Name
  Set p_m = 0.14,                         !- Program Line 1
  Set p_s = 0.22,                         !- Program Line 2
  Set s_m = 270,                          !- Program Line 3
  Set s_s = 370,                          !- Program Line 4
  Set z_m = 9.99744,                      !- Program Line 5
  Set z_s = 6.096,                        !- Program Line 6
  Set f_t = (((s_m/z_m)^p_m)*((z_s/s_s)^p_s)), !- Program Line 7
  Set Tdiff = tin_s-tout_s,               !- Program Line 8
  Set dT = @Abs Tdiff,                    !- Program Line 9
  Set c = 0.0041,                         !- Program Line 10
  Set Cs = 0.0571,                        !- Program Line 11
  Set Cw = 0.1639,                        !- Program Line 12
  Set n = 0.65,                           !- Program Line 13
  Set sft = (f_t*0.5),                    !- Program Line 14
  Set temp1 = ((c*Cw)*((sft*site_vw_s)^(2*n)))^2, !- Program Line 15
  Set Qinf = (((c*Cs*(dT^n))^2)+temp1)^0.5, !- Program Line 16
  Set Qinf = (@Max Qinf 0),               !- Program Line 17
  Set mech_vent_house_fan_sensible_load_act = 0.0, !- Program Line 18
  Set mech_vent_house_fan_latent_load_act = 0.0, !- Program Line 19
  Set OASupInPb = out_pb_s,               !- Program Line 20
  Set OASupInTemp = tout_s,               !- Program Line 21
  Set OASupInW = out_wt_s,                !- Program Line 22
  Set OASupRho = (@RhoAirFnPbTdbW OASupInPb OASupInTemp OASupInW), !- Program Line 23
  Set OASupCp = (@CpAirFnW OASupInW),     !- Program Line 24
  Set OASupInEnth = (@HFnTdbW OASupInTemp OASupInW), !- Program Line 25
  Set ZoneTemp = tin_s,                   !- Program Line 26
  Set ZoneW = win_s,                      !- Program Line 27
  Set ZoneCp = (@CpAirFnW ZoneW),         !- Program Line 28
  Set ZoneAirEnth = (@HFnTdbW ZoneTemp ZoneW), !- Program Line 29
  Set mech_vent_house_fan_cfis_act = 0.0, !- Program Line 30
  Set QWHV_cfis_sup = 0.0,                !- Program Line 31
  Set QWHV_cfis_suppl_sup = 0.0,          !- Program Line 32
  Set QWHV_cfis_suppl_exh = 0.0,          !- Program Line 33
  Set Qrange = 0,                         !- Program Line 34
  Set Qbath = 0,                          !- Program Line 35
  Set Qdryer = 0,                         !- Program Line 36
  Set QWHV_sup = 0.0,                     !- Program Line 37
  Set QWHV_exh = 0.0,                     !- Program Line 38
  Set Qsupply = QWHV_sup + QWHV_cfis_sup + QWHV_cfis_suppl_sup, !- Program Line 39
  Set Qexhaust = Qrange + Qbath + Qdryer + QWHV_exh + QWHV_cfis_suppl_exh, !- Program Line 40
  Set Qfan = (@Max Qexhaust Qsupply),     !- Program Line 41
  Set Qducts = 0,                         !- Program Line 42
  If Qducts < 0,                          !- Program Line 43
  Set Qsupply = Qsupply - Qducts,         !- Program Line 44
  Else,                                   !- Program Line 45
  Set Qexhaust = Qexhaust + Qducts,       !- Program Line 46
  EndIf,                                  !- Program Line 47
  Set Qfan_with_ducts = (@Max Qexhaust Qsupply), !- Program Line 48
  Set Qimb = (@Abs (Qsupply - Qexhaust)), !- Program Line 49
  If Qinf + Qimb > 0,                     !- Program Line 50
  Set Qtot = Qfan_with_ducts + (Qinf^2) / (Qinf + Qimb), !- Program Line 51
  Else,                                   !- Program Line 52
  Set Qtot = Qfan_with_ducts,             !- Program Line 53
  EndIf,                                  !- Program Line 54
  Set Qinf_adj = Qtot - Qfan,             !- Program Line 55
  Set infil_flow_act = Qinf_adj,          !- Program Line 56
  Set infil_program_Qinf = Qinf_adj,      !- Program Line 57
  Set infil_program_Qfan = Qfan,          !- Program Line 58
  Set Qload = Qfan,                       !- Program Line 59
  Set Effectiveness_Sens = 0.0,           !- Program Line 60
  Set Effectiveness_Lat = 0.0,            !- Program Line 61
  Set Fan_MFR = Qload * OASupRho,         !- Program Line 62
  Set ZoneInEnth = OASupInEnth,           !- Program Line 63
  Set ZoneInTemp = OASupInTemp,           !- Program Line 64
  Set FanTotalToCond = Fan_MFR * (ZoneInEnth - ZoneAirEnth), !- Program Line 65
  Set FanSensToCond = Fan_MFR * ZoneCp * (ZoneInTemp - ZoneTemp), !- Program Line 66
  Set FanLatToCond = FanTotalToCond - FanSensToCond, !- Program Line 67
  Set mech_vent_house_fan_sensible_load_act = mech_vent_house_fan_sensible_load_act + FanSensToCond, !- Program Line 68
  Set mech_vent_house_fan_latent_load_act = mech_vent_house_fan_latent_load_act + FanLatToCond; !- Program Line 69

EnergyManagementSystem:Program,
  natural_vent_program,                   !- Name
  Set Tin = tin_s,                        !- Program Line 1
  Set Tout = tout_s,                      !- Program Line 2
  Set Wout = out_wt_s,                    !- Program Line 3
  Set Pbar = out_pb_s,                    !- Program Line 4
  Set Phiout = (@RhFnTdbWPb Tout Wout Pbar), !- Program Line 5
  Set MaxHR = 0.0115,                     !- Program Line 6
  Set Tnvsp = (htg_sp_s + clg_sp_s) / 2,  !- Program Line 7
  Set NVavail = natural_vent_s,           !- Program Line 8
  Set ClgSsnAvail = cool_season,          !- Program Line 9
  Set Qnv = 0,                            !- Program Line 10
  Set Qwhf = 0,                           !- Program Line 11
  Set whole_house_fan_act = 0,            !- Program Line 12
  If ((Wout < MaxHR) && (Tin > Tout) && (Tin > Tnvsp) && (ClgSsnAvail > 0)), !- Program Line 13
  Set WHF_Flow = 0,                       !- Program Line 14
  Set Adj = (Tin-Tnvsp)/(Tin-Tout),       !- Program Line 15
  Set Adj = (@Min Adj 1),                 !- Program Line 16
  Set Adj = (@Max Adj 0),                 !- Program Line 17
  If (WHF_Flow > 0),                      !- Program Line 18
  Set Qwhf = WHF_Flow*Adj,                !- Program Line 19
  Set WHF_W = 0,                          !- Program Line 20
  Set whole_house_fan_act = WHF_W*Adj,    !- Program Line 21
  ElseIf (NVavail > 0),                   !- Program Line 22
  Set NVArea = 0,                         !- Program Line 23
  Set Cs = 8.968567957270247e-05,         !- Program Line 24
  Set Cw = 9.737000237749344e-05,         !- Program Line 25
  Set Tdiff = Tin-Tout,                   !- Program Line 26
  Set dT = (@Abs Tdiff),                  !- Program Line 27
  Set Vwind = site_vw_s,                  !- Program Line 28
  Set SGNV = NVArea*Adj*((((Cs*dT)+(Cw*(Vwind^2)))^0.5)/1000), !- Program Line 29
  Set MaxNV = 1.0747816439808002,         !- Program Line 30
  Set Qnv = (@Min SGNV MaxNV),            !- Program Line 31
  EndIf,                                  !- Program Line 32
  EndIf,                                  !- Program Line 33
  Set natural_vent_flow_act = Qnv,        !- Program Line 34
  Set whole_house_fan_flow_act = Qwhf,    !- Program Line 35
  Set natural_vent_program_Qnv = Qnv,     !- Program Line 36
  Set natural_vent_program_Qwhf = Qwhf;   !- Program Line 37

EnergyManagementSystem:Program,
  other_heated_space_Temperature_Program, !- Name
  Set other_heated_space_temp_sch = 0.0,  !- Program Line 1
  Set other_heated_space_temp_sch = other_heated_space_temp_sch + (cond_zone_temp * 0.5), !- Program Line 2
  Set other_heated_space_temp_sch = other_heated_space_temp_sch + (oa_temp * 0.5), !- Program Line 3
  If other_heated_space_temp_sch < htg_spt, !- Program Line 4
  Set other_heated_space_temp_sch = htg_spt, !- Program Line 5
  EndIf;                                  !- Program Line 6

EnergyManagementSystem:Program,
  room_ac_supply_fan_disaggregate_program, !- Name
  Set room_ac_supply_fan_clg = 0,         !- Program Line 1
  If room_ac_clg_coil_s > 0,              !- Program Line 2
  Set room_ac_supply_fan_clg = room_ac_supply_fan_s, !- Program Line 3
  EndIf;                                  !- Program Line 4

EnergyManagementSystem:Program,
  total_airflows_program,                 !- Name
  Set total_infil_flow_rate = 0,          !- Program Line 1
  Set total_mechvent_flow_rate = 0,       !- Program Line 2
  Set total_natvent_flow_rate = 0,        !- Program Line 3
  Set total_whf_flow_rate = 0,            !- Program Line 4
  Set total_infil_flow_rate = total_infil_flow_rate + (infil_program_Qinf * 1), !- Program Line 5
  Set total_mechvent_flow_rate = total_mechvent_flow_rate + (infil_program_Qfan * 1), !- Program Line 6
  Set total_natvent_flow_rate = total_natvent_flow_rate + (natural_vent_program_Qnv * 1), !- Program Line 7
  Set total_whf_flow_rate = total_whf_flow_rate + (natural_vent_program_Qwhf * 1); !- Program Line 8

EnergyManagementSystem:Program,
  total_loads_program,                    !- Name
  Set loads_htg_tot = 0,                  !- Program Line 1
  Set loads_clg_tot = 0,                  !- Program Line 2
  If htg_load_cond > 0,                   !- Program Line 3
  Set loads_htg_tot = loads_htg_tot + (htg_load_cond - clg_load_cond) * 1.0, !- Program Line 4
  EndIf,                                  !- Program Line 5
  Set loads_htg_tot = (@Max loads_htg_tot 0), !- Program Line 6
  If clg_load_cond > 0,                   !- Program Line 7
  Set loads_clg_tot = loads_clg_tot + (clg_load_cond - htg_load_cond) * 0.4, !- Program Line 8
  EndIf,                                  !- Program Line 9
  Set loads_clg_tot = (@Max loads_clg_tot 0); !- Program Line 10

EnergyManagementSystem:Program,
  unmet_hours_program,                    !- Name
  Set htg_unmet_hours = 0,                !- Program Line 1
  Set clg_unmet_hours = 0,                !- Program Line 2
  Set unit_htg_unmet_hours = 0,           !- Program Line 3
  If ((DayOfYear >= 1) && (DayOfYear <= 365)), !- Program Line 4
  Set unit_htg_unmet_hours = unit_htg_unmet_hours + conditioned_space_htg_unmet_s, !- Program Line 5
  If unit_htg_unmet_hours > htg_unmet_hours, !- Program Line 6
  Set htg_unmet_hours = unit_htg_unmet_hours, !- Program Line 7
  EndIf,                                  !- Program Line 8
  EndIf,                                  !- Program Line 9
  Set unit_clg_unmet_hours = 0,           !- Program Line 10
  If ((DayOfYear >= 1) && (DayOfYear <= 365)), !- Program Line 11
  Set unit_clg_unmet_hours = unit_clg_unmet_hours + conditioned_space_clg_unmet_s, !- Program Line 12
  If unit_clg_unmet_hours > clg_unmet_hours, !- Program Line 13
  Set clg_unmet_hours = unit_clg_unmet_hours, !- Program Line 14
  EndIf,                                  !- Program Line 15
  EndIf;                                  !- Program Line 16

EnergyManagementSystem:Program,
  water_heater_EC_adj,                    !- Name
  If WarmupFlag == 0,                     !- Program Line 1
  Set dhw_e_cons = water_heater_energy + water_heater_on_cycle_parasitic + water_heater_off_cycle_parasitic, !- Program Line 2
  Set water_heater_ec_adj_act = 0.0 * dhw_e_cons / 1, !- Program Line 3
  EndIf;                                  !- Program Line 4

EnergyManagementSystem:ProgramCallingManager,
  component_loads_program_calling_manager, !- Name
  EndOfZoneTimestepAfterZoneReporting,    !- EnergyPlus Model Calling Point
  component_loads_program;                !- Program Name 1

