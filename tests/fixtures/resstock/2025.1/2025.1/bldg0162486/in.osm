  {668ae8e1-40b2-41d4-a3db-853a5f08ddc3}, !- Handle
  {38e9f0f4-29b7-42e0-b1d8-c70bdcf9a102}, !- Object Name
  ObjectType,                             !- Feature Name 1
  String,                                 !- Feature Data Type 1
  natural vent;                           !- Feature Value 1

