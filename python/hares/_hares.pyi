# ---------------------------------------------------------------------------
# Gym / RL
# ---------------------------------------------------------------------------

# action_bounds: one finite (low, high), low <= high, per action_layout
# column, shared by every dwelling of the call. A bad pair, a dwelling
# whose deadband target holds a narrower band, or a dwelling whose
# equipment is missing or would reject its signal raises ValueError before
# any signal reaches any dwelling.
#
# A step whose observation read fails ends that environment with its
# error: terminated=True, info["error_msg"] holding the error, and its
# row of the buffer set to NaN; no substitute vector is produced.
def batch_step(
    dwellings: list[Dwelling],
    actions: list[list[float]],
    plans: list[ObservationPlan],
    action_layout: list[tuple[str, str]],
    signal_type_by_equipment: dict[str, str],
    action_bounds: list[tuple[float, float]],
    obs_out: Any,
) -> list[dict[str, Any]]: ...

def clip_action(
    dwelling: Dwelling,
    action: list[float],
    action_layout: list[tuple[str, str]],
) -> list[float]: ...
# clip_action refuses a non-finite action with a ValueError naming the
# layout column and the value, before anything is clamped or counted.

def field_bounds(field: str) -> tuple[float, float]: ...

# field_bounds_table: the engine's whole declared action-field bounds
# table, one (low, high) pair per named field, the table the gym's
# Python-side table is pinned against in both directions.
def field_bounds_table() -> dict[str, tuple[float, float]]: ...

# ---------------------------------------------------------------------------
# Catalogue / metrics from a table
# ---------------------------------------------------------------------------

# metrics_from_table: score a Timestep results table through the catalogue
# with the run's own accumulator: `table` is any object with
# __arrow_c_stream__ (a report's arrow() export, a polars frame, a pyarrow
# table), `time_res` the step resolution in whole seconds. A table whose
# consecutive Time values are not exactly time_res apart, or that carries
# a Step Count column, raises HaresSimulationError naming the mismatch,
# never wrong metrics. Per-batch schema drift below the stream schema
# (Float32 under Float64) is reinterpreted by the Arrow C stream interface
# itself (pyarrow's pa.table behaves identically); the guarantee covers
# schema-level mismatches (verified caught).
def metrics_from_table(
    table: ArrowStreamExportable,
    catalogue: Catalogue,
    time_res: int | timedelta,
    setpoint_deadband_c: float | None = None,
) -> RunMetrics: ...

# Build identity
# ---------------------------------------------------------------------------

# build_info: the extension build's compile-time identity, the record
# every run's Provenance.build carries.
def build_info() -> BuildInfo: ...

# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
# Input schema
# ---------------------------------------------------------------------------

# input_schema: the machine-readable schema of every input the engine
# reads, as a dict of its sections (config_fields, dwelling_fields,
# settings_fields, override_classes, removed_keys, schedule_columns,
# unused_schedule_columns, defaults_files, hpxml_elements,
# rejected_hpxml_elements). Every section derives from the engine's own
# typed definitions; the JSON of the dict is the schema's serialisation.
def input_schema() -> dict[str, Any]: ...

# ---------------------------------------------------------------------------
# Per-step weather channels
# ---------------------------------------------------------------------------

# resample_weather: the engine's own per-step weather channels for one
# weather input, site and config: one row per step of the configured
# horizon, the Time column and the weather channels the run's own state
# carries, in the catalogue's names. The evaluation is the environment
# update's own, so the channels match the run's internal series bitwise.
# `weather` is a path, a (text, format) pair, or a ParsedWeather; `site`
# is the resolved site dict (latitude_deg, longitude_deg, elevation_m,
# utc_offset_h; a missing coordinate is a KeyError naming it); `config`
# is the run's SimulationConfig. Returns a polars DataFrame.
def resample_weather(
    weather: str | tuple[str, str] | ParsedWeather,
    site: dict[str, float],
    config: SimulationConfig,
) -> pl.DataFrame: ...

